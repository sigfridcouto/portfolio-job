---
import Icon from './Icon.astro';
import { locales, pathFor, t, type Locale, type Page } from '../i18n';

interface Props {
  lang: Locale;
  page: Page;
}

const { lang, page } = Astro.props;
const { nav, a11y } = t(lang);
const home = pathFor(lang, 'home');
const links = [
  { href: home, label: nav.home, current: page === 'home' },
  { href: pathFor(lang, 'about'), label: nav.about, current: page === 'about' },
  // The error page has no contact section, so link to the one on the home page
  { href: page === 'error' ? `${home}#contact` : '#contact', label: nav.contact, current: false },
];
---

<header class="site-header" data-header>
  <div class="container bar">
    <a class="logo" href={home} aria-label={`sig, ${a11y.homeLink}`}>
      sig<span class="logo-dot" aria-hidden="true"></span>
    </a>

    <nav class="nav" aria-label={a11y.primaryNav}>
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={l.current ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <details class="lang" data-lang>
        <summary aria-label={`${lang.toUpperCase()}, ${nav.language}`}>
          <Icon name="globe" size={17} />
          <span>{lang.toUpperCase()}</span>
          <Icon name="chevron" size={14} class="chev" />
        </summary>
        <ul role="list" class="lang-menu">
          {
            locales.map((l) => (
              <li>
                <a href={pathFor(l, page)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
                  {l.toUpperCase()}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <button class="theme-switch" id="theme-btn" type="button" role="switch" aria-checked="true" aria-label={a11y.darkTheme}>
        <span class="ts-thumb" aria-hidden="true"></span>
        <Icon name="sun" size={16} class="ts-icon ts-sun" />
        <Icon name="moon" size={16} class="ts-icon ts-moon" />
      </button>

      <button
        class="icon-btn burger"
        id="burger"
        type="button"
        aria-label={nav.menu}
        data-label-open={nav.menu}
        data-label-close={a11y.menuClose}
        aria-expanded="false"
        aria-controls="mob-menu"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mob-menu" id="mob-menu" hidden>
    <ul role="list" class="container">
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={l.current ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('[data-header]');

  // Theme switch (role="switch": checked = dark theme). Visual state comes from [data-theme] in CSS.
  const themeBtn = document.getElementById('theme-btn');
  const syncThemeSwitch = () =>
    themeBtn?.setAttribute('aria-checked', String(root.getAttribute('data-theme') === 'dark'));
  syncThemeSwitch();
  // Enable the slide animation only after first paint, so the page never loads with a moving thumb
  requestAnimationFrame(() => requestAnimationFrame(() => themeBtn?.classList.add('ts-ready')));
  themeBtn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncThemeSwitch();
  });

  // Header style on scroll
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Language dropdown: close on outside click / Escape
  const langMenu = document.querySelector<HTMLDetailsElement>('[data-lang]');
  document.addEventListener('click', (e) => {
    if (langMenu?.open && !langMenu.contains(e.target as Node)) langMenu.open = false;
  });

  // Mobile menu
  const burger = document.getElementById('burger');
  const mob = document.getElementById('mob-menu');
  const isOpen = () => burger?.getAttribute('aria-expanded') === 'true';
  const setMenu = (open: boolean) => {
    if (!burger || !mob) return;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', (open ? burger.dataset.labelClose : burger.dataset.labelOpen) ?? '');
    mob.hidden = !open;
    header?.classList.toggle('menu-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };
  burger?.addEventListener('click', () => setMenu(!isOpen()));
  mob?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  // Close the mobile menu when the viewport grows past the mobile breakpoint
  window.matchMedia('(min-width: 721px)').addEventListener('change', (e) => {
    if (e.matches && isOpen()) setMenu(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (isOpen()) {
        setMenu(false);
        burger?.focus();
      }
      if (langMenu?.open) langMenu.open = false;
      return;
    }

    // Keep keyboard focus inside the open mobile menu (burger + menu links)
    if (e.key === 'Tab' && isOpen() && burger && mob) {
      const focusables = [burger, ...mob.querySelectorAll<HTMLElement>('a')];
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (!active || !focusables.includes(active)) {
        e.preventDefault();
        first.focus();
      } else if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .site-header.scrolled,
  .site-header.menu-open {
    background: var(--header-bg);
    border-bottom-color: var(--border);
    backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 72px;
  }

  .logo {
    display: inline-flex;
    align-items: flex-end;
    gap: 3px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .logo-dot {
    width: 8px;
    height: 8px;
    margin-bottom: 4px;
    border-radius: 2px;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
    transition: transform var(--dur) var(--ease);
  }

  .logo:hover .logo-dot {
    transform: rotate(45deg) scale(1.15);
  }

  .nav ul {
    display: flex;
    gap: 4px;
    padding: 5px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
  }

  .nav a {
    display: block;
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-2);
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface-2);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .icon-btn,
  .lang summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 40px;
    min-width: 40px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-2);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .icon-btn:hover,
  .lang summary:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  /* Theme switch: sun | moon track, the accent thumb sits under the active theme */
  .theme-switch {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    width: 76px;
    height: 40px;
    padding: 4px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    transition: border-color var(--dur) var(--ease);
  }

  .theme-switch:hover {
    border-color: var(--border-strong);
  }

  .ts-thumb {
    position: absolute;
    top: 4px;
    left: 4px;
    width: calc(50% - 4px);
    height: calc(100% - 8px);
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 14px var(--glow), 0 4px 12px -4px var(--accent);
  }

  .ts-ready .ts-thumb {
    transition: transform var(--dur) var(--ease);
  }

  :global([data-theme='dark']) .ts-thumb {
    transform: translateX(100%);
  }

  .theme-switch :global(.ts-icon) {
    position: relative;
    justify-self: center;
    color: var(--text-3);
    transition: color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .theme-switch:hover :global(.ts-icon) {
    color: var(--text-2);
  }

  :global([data-theme='light']) .theme-switch :global(.ts-sun),
  :global([data-theme='dark']) .theme-switch :global(.ts-moon) {
    color: var(--accent-ink);
  }

  .theme-switch:active :global(.ts-icon) {
    transform: scale(0.9);
  }

  .lang {
    position: relative;
  }

  .lang summary {
    padding: 0 12px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    list-style: none;
    cursor: pointer;
  }

  .lang summary::-webkit-details-marker {
    display: none;
  }

  .lang :global(.chev) {
    transition: transform var(--dur) var(--ease);
  }

  .lang[open] :global(.chev) {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 96px;
    padding: 6px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-2);
    box-shadow: var(--shadow);
  }

  .lang-menu a {
    display: block;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-2);
  }

  .lang-menu a:hover {
    background: var(--surface-2);
    color: var(--text);
  }

  .lang-menu a[aria-current='true'] {
    color: var(--accent);
  }

  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
  }

  .burger span {
    width: 16px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform var(--dur) var(--ease);
  }

  .burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mob-menu {
    height: calc(100dvh - 72px);
    border-top: 1px solid var(--border);
  }

  .mob-menu ul {
    display: flex;
    flex-direction: column;
    padding-top: 24px;
  }

  .mob-menu a {
    display: block;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .mob-menu a[aria-current='page'] {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .nav {
      display: none;
    }
    .burger {
      display: inline-flex;
    }
  }
</style>
