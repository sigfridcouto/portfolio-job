---
import Icon from './Icon.astro';
import { site, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { contact, a11y } = t(lang);
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="panel" data-reveal>
      <div class="bg-glow g1" aria-hidden="true"></div>
      <div class="bg-glow g2" aria-hidden="true"></div>

      <span class="eyebrow">{contact.eyebrow}</span>
      <h2 class="title" id="contact-title">{contact.title}</h2>
      <p class="text">{contact.text}</p>

      <div class="ctas">
        <a class="btn btn-primary" href={`mailto:${site.email}`}>
          <Icon name="mail" />
          {contact.email}
        </a>
        <a class="btn btn-ghost" href={site.linkedin} target="_blank" rel="noopener noreferrer">
          <Icon name="linkedin" />
          LinkedIn
        </a>
      </div>

      <button class="email" type="button" data-copy={site.email} data-copied={a11y.copied} aria-label={`${a11y.copyEmail}: ${site.email}`}>
        <span class="email-text">{site.email}</span>
        <Icon name="copy" size={16} class="i-copy" />
        <Icon name="check" size={16} class="i-check" />
      </button>
      <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>

      <p class="note">
        <Icon name="pin" size={16} />
        {contact.note}
      </p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const status = btn.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    let timer = 0;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.classList.add('copied');
        if (status) status.textContent = btn.dataset.copied ?? '';
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.classList.remove('copied');
          if (status) status.textContent = '';
        }, 1800);
      } catch {
        // Clipboard unavailable (e.g. insecure context): select the address so it can be copied manually
        const text = btn.querySelector('.email-text');
        const selection = window.getSelection();
        if (text && selection) {
          const range = document.createRange();
          range.selectNodeContents(text);
          selection.removeAllRanges();
          selection.addRange(range);
        }
      }
    });
  });
</script>

<style>
  .panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(40px, 7vw, 88px) clamp(24px, 6vw, 80px);
    border-radius: 32px;
    border: 1px solid var(--border);
    background: linear-gradient(160deg, var(--surface-2), var(--surface));
    text-align: center;
  }

  .g1 {
    width: 420px;
    height: 420px;
    top: -200px;
    left: -120px;
    color: var(--accent);
    opacity: 0.22;
  }

  .g2 {
    width: 380px;
    height: 380px;
    bottom: -220px;
    right: -100px;
    color: var(--accent-2);
    opacity: 0.22;
  }

  .eyebrow {
    justify-content: center;
  }

  .title {
    font-size: clamp(2.2rem, 6vw, 4rem);
  }

  .text {
    max-width: 560px;
    margin: 20px auto 0;
    font-size: 1.1rem;
    color: var(--text-2);
  }

  .ctas {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .email {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    padding: 6px 12px;
    border-radius: 8px;
    font-family: ui-monospace, 'Cascadia Code', Menlo, monospace;
    font-size: 0.9rem;
    color: var(--text-2);
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .email:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .email :global(.i-check),
  .email.copied :global(.i-copy) {
    display: none;
  }

  .email.copied :global(.i-check) {
    display: block;
    color: var(--accent);
  }

  .note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
    font-size: 0.875rem;
    color: var(--text-3);
  }

  .note :global(svg) {
    flex-shrink: 0;
  }
</style>
