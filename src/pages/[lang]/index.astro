---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';
import Icon from '../../components/Icon.astro';
import profile from '../../assets/profile.webp';
import { localeStaticPaths, pathFor, t, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const d = t(lang);
const focusIcons = ['layout', 'server', 'refresh'] as const;
---

<Layout lang={lang} page="home" title={d.meta.homeTitle} description={d.meta.homeDescription}>
  <!-- Hero -->
  <section class="hero" aria-label={d.a11y.intro}>
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="bg-glow hg1" aria-hidden="true"></div>
    <div class="bg-glow hg2" aria-hidden="true"></div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="badge" data-reveal>
          <span class="pulse" aria-hidden="true"></span>
          {d.meta.jobTitle}, C# / .NET, Angular
        </p>

        <h1 class="name" data-reveal style="--delay:80ms">
          Sigfrid Couto <span class="gradient-text">Fernández</span>
        </h1>

        <p class="lead" data-reveal style="--delay:160ms">{d.hero.lead}</p>
        <p class="sub" data-reveal style="--delay:220ms">{d.hero.text}</p>

        <p class="loc" data-reveal style="--delay:280ms">
          <Icon name="pin" size={16} />
          {d.hero.location}
        </p>

        <div class="ctas" data-reveal style="--delay:340ms">
          <a class="btn btn-primary" href="#contact">
            {d.hero.ctaPrimary}
            <Icon name="arrow" />
          </a>
          <a class="btn btn-ghost" href="#experience">{d.hero.ctaSecondary}</a>
        </div>

        <dl class="stats" data-reveal style="--delay:400ms">
          {
            d.hero.stats.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="hero-visual" data-reveal style="--delay:200ms">
        <div class="portrait">
          <Picture
            src={profile}
            alt="Sigfrid Couto Fernández"
            formats={['avif']}
            fallbackFormat="webp"
            quality={60}
            widths={[260, 400, 520, 800]}
            sizes="(max-width: 960px) min(calc(70vw - 34px), 288px), 388px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="float f1" aria-hidden="true">
          <span class="dot" style="background:#a78bfa"></span>C# / .NET
        </div>
        <div class="float f2" aria-hidden="true">
          <span class="dot" style="background:#f43f5e"></span>Angular
        </div>
        <div class="float f3" aria-hidden="true">
          <span class="dot" style="background:#38bdf8"></span>TypeScript
        </div>
      </div>
    </div>
  </section>

  <!-- Core engineering areas -->
  <section class="section" id="focus" aria-labelledby="focus-title">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">{d.focus.eyebrow}</span>
        <h2 class="section-title" id="focus-title">{d.focus.title}</h2>
        <p class="section-intro">{d.focus.intro}</p>
      </header>

      <div class="bento">
        {
          d.focus.cards.map((c, i) => (
            <article class={`card spotlight focus-card fc-${i}`} data-reveal style={`--delay:${i * 90}ms`}>
              <div class="fc-top">
                <span class="fc-icon">
                  <Icon name={focusIcons[i]} size={22} />
                </span>
                <span class="fc-sub">{c.sub}</span>
              </div>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
              <ul role="list" class="fc-tags" aria-label={d.a11y.technologies}>
                {c.tags.map((tag) => (
                  <li>
                    <Icon name="check" size={16} />
                    {tag}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Professional snapshot -->
  <section class="section snapshot" id="experience" aria-labelledby="exp-title">
    <div class="container">
      <header class="section-head row-head" data-reveal>
        <div>
          <span class="eyebrow">{d.snapshot.eyebrow}</span>
          <h2 class="section-title" id="exp-title">{d.snapshot.title}</h2>
        </div>
        <a class="more" href={`${pathFor(lang, 'about')}#career`}>
          {d.snapshot.more}
          <Icon name="arrow" size={18} />
        </a>
      </header>

      <ol role="list" class="exp-list">
        {
          d.snapshot.items.map((it, i) => (
            <li class="card spotlight exp" data-reveal style={`--delay:${i * 90}ms`}>
              <span class="exp-period">{it.period}</span>
              <div class="exp-main">
                <h3>{it.company}</h3>
                <span class="exp-place">
                  <Icon name="pin" size={14} />
                  {it.place}
                </span>
              </div>
              <p>{it.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- How I work -->
  <section class="section" id="approach" aria-labelledby="approach-title">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">{d.approach.eyebrow}</span>
        <h2 class="section-title" id="approach-title">{d.approach.title}</h2>
      </header>

      <ol role="list" class="steps">
        {
          d.approach.steps.map((s, i) => (
            <li class="step" data-reveal style={`--delay:${i * 100}ms`}>
              <span class="step-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Contact lang={lang} />
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(48px, 8vw, 112px) clamp(64px, 9vw, 128px);
    margin-top: -72px;
    padding-top: calc(72px + clamp(48px, 8vw, 112px));
    overflow: hidden;
  }

  .hg1 {
    width: 560px;
    height: 560px;
    top: -260px;
    right: -120px;
    color: var(--accent);
    opacity: 0.18;
  }

  .hg2 {
    width: 460px;
    height: 460px;
    top: 120px;
    left: -220px;
    color: var(--accent-2);
    opacity: 0.16;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-2);
  }

  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.2s var(--ease) infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  .name {
    margin-top: 24px;
    font-size: clamp(2.75rem, 8vw, 5.75rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .name .gradient-text {
    display: block;
  }

  .lead {
    margin-top: 28px;
    max-width: 600px;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.5;
    color: var(--text);
    font-weight: 500;
  }

  .sub {
    margin-top: 12px;
    max-width: 600px;
    font-size: 1.05rem;
    color: var(--text-2);
  }

  .loc {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    font-size: 0.92rem;
    color: var(--text-3);
  }

  .loc :global(svg) {
    flex-shrink: 0;
    color: var(--accent);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .stats dd {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .stats dt {
    font-size: 0.85rem;
    color: var(--text-3);
  }

  .hero-visual {
    position: relative;
    justify-self: center;
    width: min(100%, 400px);
  }

  .portrait {
    position: relative;
    aspect-ratio: 1;
    border-radius: 36% 64% 58% 42% / 42% 40% 60% 58%;
    padding: 6px;
    background: conic-gradient(from 160deg, var(--accent), var(--accent-2), var(--accent));
    box-shadow: 0 40px 80px -30px var(--glow);
    animation: morph 14s ease-in-out infinite alternate;
  }

  .portrait :global(picture) {
    display: contents;
    border-radius: inherit; /* so the img can inherit the blob shape */
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    background: var(--bg-2);
  }

  @keyframes morph {
    50% {
      border-radius: 58% 42% 40% 60% / 54% 62% 38% 46%;
    }
  }

  .float {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 0.82rem;
    font-weight: 600;
    box-shadow: var(--shadow);
    animation: float 6s ease-in-out infinite;
  }

  .float .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .f1 {
    top: 8%;
    left: -12%;
  }

  .f2 {
    bottom: 14%;
    right: -10%;
    animation-delay: -2s;
  }

  .f3 {
    bottom: -2%;
    left: 6%;
    animation-delay: -4s;
  }

  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }

  /* Bento */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
  }

  .focus-card {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 3vw, 36px);
  }

  .fc-0,
  .fc-1 {
    grid-column: span 3;
  }

  .fc-2 {
    grid-column: span 6;
  }

  .fc-2 .fc-tags {
    grid-template-columns: repeat(2, 1fr);
  }

  .fc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .fc-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid var(--border);
  }

  .fc-sub {
    font-family: ui-monospace, 'Cascadia Code', Menlo, monospace;
    font-size: 0.78rem;
    color: var(--text-3);
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
  }

  .focus-card h3 {
    font-size: 1.5rem;
  }

  .focus-card > p {
    margin-top: 12px;
    color: var(--text-2);
  }

  .fc-tags {
    display: grid;
    gap: 10px;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .fc-tags li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.92rem;
    color: var(--text-2);
  }

  .fc-tags :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--accent);
  }

  /* Snapshot */
  .snapshot {
    background: linear-gradient(180deg, transparent, var(--bg-2) 20%, var(--bg-2) 80%, transparent);
  }

  .row-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    max-width: none;
    flex-wrap: wrap;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--accent);
  }

  .more :global(svg) {
    transition: transform var(--dur) var(--ease);
  }

  .more:hover :global(svg) {
    transform: translateX(4px);
  }

  .exp-list {
    display: grid;
    gap: 16px;
  }

  .exp {
    display: grid;
    grid-template-columns: 160px 220px 1fr;
    align-items: center;
    gap: 24px;
    padding: 28px 32px;
    border-radius: var(--radius);
  }

  .exp-period {
    font-family: ui-monospace, 'Cascadia Code', Menlo, monospace;
    font-size: 0.85rem;
    color: var(--accent);
  }

  .exp h3 {
    font-size: 1.35rem;
  }

  .exp-place {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
    font-size: 0.85rem;
    color: var(--text-3);
  }

  .exp p {
    color: var(--text-2);
  }

  /* Steps */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    counter-reset: step;
  }

  .step {
    position: relative;
    padding: 32px 4px 0;
    border-top: 1px solid var(--border);
  }

  .step::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
  }

  .step-num {
    display: block;
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    /* Solid accent gradient fill: readable in both themes, matches the line above */
    background: linear-gradient(100deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
    margin-bottom: 20px;
  }

  .step h3 {
    font-size: 1.3rem;
  }

  .step p {
    margin-top: 12px;
    color: var(--text-2);
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      order: -1;
      width: min(70%, 300px);
    }
    .exp {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .steps {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 720px) {
    .fc-0,
    .fc-1,
    .fc-2 {
      grid-column: span 6;
    }
    .fc-2 .fc-tags {
      grid-template-columns: 1fr;
    }
    .f1 {
      left: -8%;
    }
    .f2 {
      right: -8%;
    }
    .exp {
      padding: 24px;
    }
  }
</style>
