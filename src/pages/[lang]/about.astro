---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';
import Icon from '../../components/Icon.astro';
import profile from '../../assets/profile.webp';
import { localeStaticPaths, t, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const d = t(lang);
const a = d.about;
const principleIcons = ['message', 'check', 'leaf', 'handshake'] as const;
---

<Layout lang={lang} page="about" title={d.meta.aboutTitle} description={d.meta.aboutDescription}>
  <!-- Intro -->
  <section class="intro">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="bg-glow ig" aria-hidden="true"></div>

    <div class="container intro-grid">
      <div class="portrait" data-reveal>
        <Picture
          src={profile}
          alt="Sigfrid Couto Fernández"
          formats={['avif']}
          fallbackFormat="webp"
          quality={60}
          widths={[210, 270, 420, 540]}
          sizes="(max-width: 720px) min(calc(60vw - 30px), 210px), 270px"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div>
        <span class="eyebrow" data-reveal>{d.nav.about}</span>
        <h1 class="title" data-reveal style="--delay:80ms">Sigfrid Couto Fernández</h1>
        <p class="role gradient-text" data-reveal style="--delay:140ms">{a.role}</p>

        <dl class="facts" data-reveal style="--delay:200ms">
          {
            a.facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <div class="container bio" data-reveal>
      {a.bio.map((p, i) => <p class={i === 0 ? 'bio-lead' : undefined}>{p}</p>)}
    </div>
  </section>

  <!-- Stack -->
  <section class="section" id="stack" aria-labelledby="stack-title">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">{a.stack.eyebrow}</span>
        <h2 class="section-title" id="stack-title">{a.stack.title}</h2>
      </header>

      <div class="stack-grid">
        {
          a.stack.groups.map((g, i) => (
            <div class="card spotlight stack-group" data-reveal style={`--delay:${i * 70}ms`}>
              <h3>
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                {g.name}
              </h3>
              <ul role="list">
                {g.items.map((item) => (
                  <li class="chip">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="section principles" id="engineering-principles" aria-labelledby="principles-title">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">{a.principles.eyebrow}</span>
        <h2 class="section-title" id="principles-title">{a.principles.title}</h2>
        <p class="section-intro">{a.principles.intro}</p>
      </header>

      <div class="principle-grid">
        {
          a.principles.items.map((p, i) => (
            <article class="card spotlight principle" data-reveal style={`--delay:${i * 80}ms`}>
              <span class="p-icon">
                <Icon name={principleIcons[i]} size={22} />
              </span>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Career timeline -->
  <section class="section" id="career" aria-labelledby="career-title">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">{a.career.eyebrow}</span>
        <h2 class="section-title" id="career-title">{a.career.title}</h2>
      </header>

      <ol role="list" class="timeline">
        {
          a.career.items.map((it, i) => (
            <li class="tl-item" data-reveal style={`--delay:${Math.min(i, 4) * 60}ms`}>
              <span class="tl-period">{it.period}</span>
              <span class="tl-dot" aria-hidden="true" />
              <div class="tl-body">
                <div class="tl-head">
                  <h3>{it.company}</h3>
                  <span class="tl-place">
                    <Icon name="pin" size={14} />
                    {it.place}
                  </span>
                </div>
                <ul role="list" class="tl-tags">
                  {it.detail.split(', ').map((tag) => (
                    <li class="chip">{tag}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Languages, education, outside work -->
  <section class="section extras" aria-labelledby="lang-title">
    <div class="container extras-grid">
      <div class="card langs" data-reveal>
        <span class="eyebrow">{a.languages.eyebrow}</span>
        <h2 class="h2-sm" id="lang-title">{a.languages.title}</h2>
        <ul role="list" class="lang-list">
          {
            a.languages.items.map((l) => (
              <li>
                <span class="l-code">{l.code}</span>
                <div class="l-body">
                  <div class="l-row">
                    <span class="l-name" lang={l.code.toLowerCase()}>
                      {l.name}
                    </span>
                    <span class="l-level">{l.level}</span>
                  </div>
                  <span class="bar" aria-hidden="true">
                    <span style={`--w:${l.value}%`} />
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="side">
        <div class="card mini spotlight" data-reveal style="--delay:80ms">
          <span class="p-icon"><Icon name="graduation" size={22} /></span>
          <h2 class="h2-sm">{a.education.title}</h2>
          <p>{a.education.text}</p>
        </div>
        <div class="card mini spotlight" data-reveal style="--delay:160ms">
          <span class="p-icon"><Icon name="run" size={22} /></span>
          <h2 class="h2-sm">{a.outside.title}</h2>
          <p>{a.outside.text}</p>
        </div>
      </div>
    </div>
  </section>

  <Contact lang={lang} />
</Layout>

<style>
  .intro {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: -72px;
    padding-top: calc(72px + clamp(48px, 7vw, 96px));
    padding-bottom: clamp(32px, 5vw, 64px);
  }

  .ig {
    width: 520px;
    height: 520px;
    top: -240px;
    left: 20%;
    color: var(--accent-2);
    opacity: 0.18;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 72px);
  }

  .portrait {
    aspect-ratio: 1;
    border-radius: 32px;
    padding: 5px;
    background: linear-gradient(140deg, var(--accent), var(--accent-2));
    box-shadow: 0 30px 70px -30px var(--glow);
    transform: rotate(-3deg);
  }

  .portrait :global(picture) {
    display: contents;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 28px;
  }

  .title {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    letter-spacing: -0.05em;
  }

  .role {
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    gap: 16px 36px;
    margin-top: 32px;
  }

  .facts dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .facts dd {
    margin-top: 4px;
    font-weight: 500;
  }

  .bio {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 48px;
    margin-top: clamp(48px, 7vw, 88px);
    padding-top: clamp(32px, 5vw, 48px);
    border-top: 1px solid var(--border);
    color: var(--text-2);
  }

  .bio-lead {
    grid-column: 1 / -1;
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    line-height: 1.5;
    color: var(--text);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* Stack */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
  }

  .stack-group {
    grid-column: span 2;
    padding: 28px;
  }

  .stack-group:nth-child(4),
  .stack-group:nth-child(5) {
    grid-column: span 3;
  }

  .stack-group h3 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 1.25rem;
    margin-bottom: 20px;
  }

  .idx {
    font-family: ui-monospace, 'Cascadia Code', Menlo, monospace;
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--accent);
  }

  .stack-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack-group .chip {
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .stack-group .chip:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  /* Principles */
  .principles {
    background: linear-gradient(180deg, transparent, var(--bg-2) 20%, var(--bg-2) 80%, transparent);
  }

  .principle-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .principle {
    padding: clamp(24px, 3vw, 36px);
  }

  .p-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 24px;
    border-radius: 14px;
    background: var(--accent-soft);
    border: 1px solid var(--border);
    color: var(--accent);
  }

  .principle h3 {
    font-size: 1.35rem;
  }

  .principle p {
    margin-top: 10px;
    color: var(--text-2);
  }

  /* Timeline */
  .timeline {
    position: relative;
  }

  .tl-item {
    display: grid;
    grid-template-columns: 150px 24px 1fr;
    gap: 0 24px;
    padding-bottom: 36px;
    position: relative;
  }

  .tl-item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(150px + 24px + 11.5px);
    top: 22px;
    bottom: 0;
    width: 1px;
    background: linear-gradient(var(--border-strong), var(--border));
  }

  .tl-period {
    padding-top: 4px;
    text-align: right;
    font-family: ui-monospace, 'Cascadia Code', Menlo, monospace;
    font-size: 0.85rem;
    color: var(--text-3);
    white-space: nowrap;
  }

  .tl-dot {
    justify-self: center;
    width: 12px;
    height: 12px;
    margin-top: 8px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
    transition: background-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .tl-item:first-child .tl-dot,
  .tl-item:hover .tl-dot {
    background: var(--accent);
    box-shadow: 0 0 0 6px var(--accent-soft), 0 0 18px var(--accent);
  }

  .tl-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 14px;
  }

  .tl-head h3 {
    font-size: 1.35rem;
  }

  .tl-place {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.85rem;
    color: var(--text-3);
  }

  .tl-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  /* Extras */
  .extras-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 20px;
  }

  .langs {
    padding: clamp(24px, 3.5vw, 40px);
  }

  .h2-sm {
    font-size: 1.6rem;
  }

  .lang-list {
    display: grid;
    gap: 20px;
    margin-top: 28px;
  }

  .lang-list li {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .l-code {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    font-family: ui-monospace, 'Cascadia Code', Menlo, monospace;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
  }

  .l-body {
    flex: 1;
    min-width: 0;
  }

  .l-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .l-name {
    font-weight: 600;
  }

  .l-level {
    font-size: 0.85rem;
    color: var(--text-3);
  }

  .bar {
    display: block;
    height: 4px;
    margin-top: 8px;
    border-radius: 4px;
    background: var(--surface-2);
    overflow: hidden;
  }

  .bar span {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1.2s var(--ease) 0.2s;
  }

  .revealed .bar span,
  :global(html:not(.js)) .bar span {
    transform: scaleX(1);
  }

  .side {
    display: grid;
    gap: 20px;
  }

  .mini {
    padding: clamp(24px, 3vw, 32px);
  }

  .mini p {
    margin-top: 10px;
    color: var(--text-2);
  }

  @media (max-width: 960px) {
    .facts {
      grid-template-columns: repeat(2, auto);
    }
    .stack-group,
    .stack-group:nth-child(4),
    .stack-group:nth-child(5) {
      grid-column: span 3;
    }
    .extras-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      width: min(60%, 220px);
    }
    .bio {
      grid-template-columns: 1fr;
    }
    .stack-group,
    .stack-group:nth-child(4),
    .stack-group:nth-child(5) {
      grid-column: span 6;
    }
    .principle-grid {
      grid-template-columns: 1fr;
    }
    .tl-item {
      grid-template-columns: 24px 1fr;
      gap: 0 16px;
    }
    .tl-item:not(:last-child)::after {
      left: 11.5px;
    }
    .tl-period {
      grid-column: 2;
      grid-row: 1;
      text-align: left;
      padding: 0 0 4px;
    }
    .tl-dot {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    .tl-body {
      grid-column: 2;
    }
  }
</style>
